# Kernel config based on: arch/arm64/configs/defconfig
# Overlay: rebasado sobre pmaports main post-MR !9035 (bb84c79b7, "build with
# LLVM"), que ya fijo las dos cosas que rompian este paquete:
#   * anadio zstd a makedepends, porque el config trae
#     CONFIG_MODULE_COMPRESS_ZSTD=y y modules_install invoca el binario zstd
#     (sin el: "zstd: not found", Error 127 en scripts/Makefile.modinst).
#   * movio INSTALL_MOD_PATH a "$pkgdir"/usr, que es donde espera los modulos
#     Alpine con /usr merge (y donde ya estan en el dispositivo vivo).
# Se mantiene el fork minorum/linux @ 3a1ea769 (rama begonia-conn-wifi) porque
# es el que trae el stack wifi/bt; upstream ya no lo usa. Tambien se mantiene
# gcc en vez de LLVM porque es lo que compilo bien con este config.
maintainer="Dinolek <git@dinolek.me>"
_flavor="postmarketos-mediatek-mt6785"
pkgname=linux-$_flavor
pkgver=6.16.4
pkgrel=1
pkgdesc="Mainline kernel fork for MT6785"
arch="aarch64"
_carch="arm64"

url="https://gitlab.postmarketos.org/minorum/linux"
license="GPL-2.0-only"
options="
	!strip
	!check
	!tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
"
makedepends="
	bash
	bison
	elfutils-dev
	findutils
	flex
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"

# Source: begonia-conn-wifi forward-port (minorum/linux @ 3a1ea769, v6.16.4)
_tag="3a1ea7694219eb2fd513f0e630f2a882eab5c86f"
_config="config-$_flavor.$arch"
source="
	https://gitlab.postmarketos.org/minorum/linux/-/archive/$_tag/linux-3a1ea769.tar.gz
	$_config
"
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot

	make dtbs_install modules_install zinstall \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/"$_flavor"/kernel.release
}

# El config es un source sin URL: pmbootstrap lo copia del checkout de pmaports
# (por eso enable_kernel_drivers.sh puede mutarlo antes del build) y el hash
# documenta con que commit debe coincidir.
sha512sums="
	47ae3ae3d879fb1929ca5e74977688f9933c162324fab12f493a9f0fd813d7437eb8427fb4865b6513daca747b69874a5aa8d298989fc6409606399865e9a4fd  linux-3a1ea769.tar.gz
	3a403015d0f2d56218793ebdeddd786efcad2a40d059d08cbc875dc42f8593ae3585b050195693eb10c3eaa24411d115b247ad651b65efe00df95aedab0271f0  config-postmarketos-mediatek-mt6785.aarch64
"

c14ea5e1fd73839e39737a810500a6efaa140999316bebc3a96f93f0800844cdbd0aca1cb336ccc1e1f1b149fd1f1382e28f9a39d9a45a3a3b96c1f5f00a3f83  config-postmarketos-mediatek-mt6785.aarch64
"

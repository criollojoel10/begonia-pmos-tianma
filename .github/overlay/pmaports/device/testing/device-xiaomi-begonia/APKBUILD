# Reference: <https://postmarketos.org/devicepkg>
maintainer="Dinolek <git@dinolek.me>"
pkgname=device-xiaomi-begonia
pkgdesc="Xiaomi Redmi Note 8 Pro"
pkgver=7
# pkgrel=1, NO 0: sin esto apk da por buena la version publicada en edge
# (device-xiaomi-begonia-6-r0) en vez de construir la de este arbol, que es
# la unica que depende de firmware-xiaomi-begonia-connectivity y la unica que
# trae el servicio de arranque del wifi. Con pkgrel=0 el build 36304158010
# salio verde installing el paquete de edge y los 7 blobs de firmware se
# quedaron fuera de la imagen: sin ellos wlan_gen4m no puede pedir firmware y
# wlan0 no aparece nunca.
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	firmware-xiaomi-begonia-connectivity
	firmware-xiaomi-begonia-touchscreen
	linux-postmarketos-mediatek-mt6785
	mesa-vulkan-panfrost
	mkbootimg
	postmarketos-base
"
makedepends="android-tools devicepkg-dev dtc"
source="deviceinfo kernel-cmdline.conf modules-initfs mediatek-wifi.sh mediatek-wifi.service"

build() {
	devicepkg_build $startdir $pkgname

	# begonia bootloader needs empty dtbo, build it and add as recovery_dtbo to final image
	mkdir "$builddir"
	echo '/dts-v1/;/{};' | dtc -I dts -O dtb -o "$builddir/empty.dtb"
	mkdtboimg create "$builddir/empty.dtbo" "$builddir/empty.dtb"
}

package() {
	devicepkg_package $startdir $pkgname

	mkdir -p "$pkgdir/boot"
	install -Dm644 "$builddir/empty.dtbo" \
		"$pkgdir/boot/"

	# El wifi interno no arranca solo: hay que cargar los tres modulos del
	# fwport de minorum y escribir un '1' en /dev/wmtWifi, que es lo que le
	# pide al conn-MCU que levante el firmware del chip. Este servicio lo hace
	# en el arranque; sin el, el movil arranca sin wlan0 y toca hacerlo a mano.
	# Verificado en un begonia con el wifi asi encendido: escanea en 2.4 y
	# 5 GHz y se asocia con DHCP.
	#
	# NO va en modules-initfs a proposito: ahi solo entran modulos, y el
	# trigger es un write a /dev/wmtWifi que ademas necesita al BTIF ya
	# registrado. Un oneshot antes de NetworkManager es lo que hace falta.
	install -Dm755 "$srcdir/mediatek-wifi.sh" \
		"$pkgdir/usr/libexec/mediatek-wifi.sh"
	install -Dm644 "$builddir/mediatek-wifi.service" \
		"$pkgdir/usr/lib/systemd/system/mediatek-wifi.service"

	# El servicio tiene que arrancar en cada boot. Mismo idiom que el paquete
	# device de Kupfer: symlink en multi-user.target.wants.
	mkdir -p "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -sf /usr/lib/systemd/system/mediatek-wifi.service \
		"$pkgdir/usr/lib/systemd/system/multi-user.target.wants/mediatek-wifi.service"
}

# Los tres ficheros de source= son del propio arbol, no descargas, asi que el
# sha512sums de abajo es una formalidad. OJO: el de upstream pmaports es el de
# SUS deviceinfo, y este deviceinfo lleva deviceinfo_rootfs_image_sector_size
# y deviceinfo_flash_sparse, asi que el hash es OTRO. El paso de CI
# "Recompute sha512sums of the local device files" los recalcula antes de
# compilar (.github/scripts/fix-device-checksums.py) para que editar
# deviceinfo no pueda romper el build; estos valores son los correctos.
sha512sums="

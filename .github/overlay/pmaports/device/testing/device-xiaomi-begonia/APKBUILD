# Reference: <https://postmarketos.org/devicepkg>
maintainer="Dinolek <git@dinolek.me>"
pkgname=device-xiaomi-begonia
pkgdesc="Xiaomi Redmi Note 8 Pro"
pkgver=6
# pkgrel=1, NO 0: sin esto apk da por buena la version publicada en edge
# (device-xiaomi-begonia-6-r0) en vez de construir la de este arbol, que es
# la unica que depende de firmware-xiaomi-begonia-connectivity. Con pkgrel=0
# el build 36304158010 salio verde installing el paquete de edge y los 7 blobs
# de /lib/firmware/mediatek/ se quedaron fuera de la imagen: sin ellos
# wlan_gen4m no puede pedir firmware y wlan0 no aparece nunca.
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	firmware-xiaomi-begonia-connectivity
	firmware-xiaomi-begonia-touchscreen
	linux-postmarketos-mediatek-mt6785
	mesa-vulkan-panfrost
	mkbootimg
	postmarketos-base
"
makedepends="android-tools devicepkg-dev dtc"
source="deviceinfo kernel-cmdline.conf modules-initfs"

build() {
	devicepkg_build $startdir $pkgname

	# begonia bootloader needs empty dtbo, build it and add as recovery_dtbo to final image
	mkdir "$builddir"
	echo '/dts-v1/;/{};' | dtc -I dts -O dtb -o "$builddir/empty.dtb"
	mkdtboimg create "$builddir/empty.dtbo" "$builddir/empty.dtb"
}

package() {
	devicepkg_package $startdir $pkgname

	mkdir -p "$pkgdir/boot"
	install -Dm644 "$builddir/empty.dtbo" \
		"$pkgdir/boot/"
}

# Los tres ficheros de source= son del propio arbol, no descargas, asi que el
# sha512sums de abajo es una formalidad. OJO: el de upstream pmaports es el de
# SUS deviceinfo, y este deviceinfo lleva deviceinfo_rootfs_image_sector_size
# y deviceinfo_flash_sparse, asi que el hash es OTRO. El paso de CI
# "Recompute sha512sums of the local device files" los recalcula antes de
# compilar (.github/scripts/fix-device-checksums.py) para que editar
# deviceinfo no pueda romper el build; estos valores son los correctos.
sha512sums="

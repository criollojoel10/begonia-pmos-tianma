maintainer="Dinolek <git@dinolek.me>"
pkgname=firmware-xiaomi-begonia
pkgver=20260617
# pkgrel>=1 por lo mismo que en device-xiaomi-begonia: apk toma
# firmware-xiaomi-begonia-20260617-r0 de edge si pkgrel=0, y entonces este
# APKBUILD no se ejecuta y los blobs no llegan a la imagen.
pkgrel=1
pkgdesc="Firmware for Xiaomi Redmi Note 8 Pro"
subpackages="
	$pkgname-touchscreen
	$pkgname-connectivity
"
url="https://gitlab.postmarketos.org/mt6785-mainline/firmware"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
_commit="33aa9fe1db0079945fa272e42f04db732489319d"
source="
	https://gitlab.postmarketos.org/mt6785-mainline/firmware/-/archive/$_commit/firmware-$_commit.tar.gz
	10-touch-firmware.files
"
builddir="$srcdir/firmware-$_commit"

package() {
	# parent package is empty
	mkdir -p "$pkgdir"
}

touchscreen() {
	pkgdesc="Xiaomi Redmi Note 8 Pro touchscreen firmware"

	# Esta unidad es de panel Tianma. El DTB de la rama 6.16 (la unica que hay
	# para begonia) solo conoce la variante CSOT: el panel declara
	# compatible = "xiaomi,begonia-csot-nt36672a" y el nodo del tactil pide
	# firmware-name = "novatek/nt36672a_begonia_csot.bin", que el driver
	# novatek-nvt-ts-spi pasa tal cual a request_firmware(). Con el binario
	# equivocado el panel se enciende pero el touch sale con los ejes cruzados,
	# sin ningun error en el log. Por eso el nombre CSOT se sirve con el
	# binario Tianma (md5 7d67c2e9167f1a630576c177c1b831f7).
	install -Dm644 "$builddir/novatek/nt36672a_begonia_tianma.bin.zst" -t \
		"$subpkgdir/lib/firmware/novatek/"
	install -Dm644 "$builddir/novatek/nt36672a_begonia_csot.bin.zst" -t \
		"$subpkgdir/lib/firmware/novatek/"
	cp -f "$subpkgdir/lib/firmware/novatek/nt36672a_begonia_tianma.bin.zst" \
		"$subpkgdir/lib/firmware/novatek/nt36672a_begonia_csot.bin.zst"
	install -Dm644 "$srcdir/10-touch-firmware.files" -t \
		"$subpkgdir/usr/share/mkinitfs/files/"
}

connectivity() {
	pkgdesc="Xiaomi Redmi Note 8 Pro WiFi/Bluetooth connectivity firmware"

	# OJO: en la RAIZ de /lib/firmware/, no en un subdirectorio. El fwport de
	# minorum llama a request_firmware() con nombres pelados, sin carpeta:
	#   wmt_conf.h:34        "WMT_SOC.cfg"
	#   wmt_dev.c:406,459,508 "soc1_0_patch_mcu_2a_1_hdr.bin"
	#   wmt_ctrl.c:654-656   "soc1_0_ram_{bt,wifi,mcu}_2a_1_hdr.bin"
	#   config.h:149         "WIFI_RAM_CODE" -> connacConstructFirmwarePrio()
	#                        genera "WIFI_RAM_CODE_soc1_0_2a_1.bin"
	#   gl_init.c:3322,3372  "wifi.cfg"
	# Asi que el kernel solo los encuentra en /lib/firmware/ (o /usr/lib/
	# firmware/) en la raiz. Con los ficheros en firmware/mediatek/, que es
	# donde los metimos en los builds anteriores, modprobe wmt_drv falla con
	#   (NULL device *): Direct firmware load for WMT_SOC.cfg failed with
	#   error -2
	#   [HIF-SDIO][E]wmt_dev_patch_get(413):failed to open or read!(WMT_SOC.cfg)
	# y wlan0 no aparece nunca. Los .zst los descomprime el kernel solo
	# (CONFIG_FW_LOADER_COMPRESS_ZSTD=y).
	install -Dm644 "$builddir/mediatek/WIFI_RAM_CODE_soc1_0_2a_1.bin.zst" -t \
		"$subpkgdir/lib/firmware/"
	install -Dm644 "$builddir/mediatek/WMT_SOC.cfg.zst" -t \
		"$subpkgdir/lib/firmware/"
	install -Dm644 "$builddir/mediatek/soc1_0_patch_mcu_2a_1_hdr.bin.zst" -t \
		"$subpkgdir/lib/firmware/"
	install -Dm644 "$builddir/mediatek/soc1_0_ram_bt_2a_1_hdr.bin.zst" -t \
		"$subpkgdir/lib/firmware/"
	install -Dm644 "$builddir/mediatek/soc1_0_ram_mcu_2a_1_hdr.bin.zst" -t \
		"$subpkgdir/lib/firmware/"
	install -Dm644 "$builddir/mediatek/soc1_0_ram_wifi_2a_1_hdr.bin.zst" -t \
		"$subpkgdir/lib/firmware/"
	install -Dm644 "$builddir/mediatek/wifi.cfg.zst" -t \
		"$subpkgdir/lib/firmware/"
}

